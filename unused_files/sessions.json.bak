  "session_1775048053656 ": {
    "messages": [
      {
        "role": "user",
        "content": "🎓 What are the promotion rules?"
      },
      {
        "role": "assistant",
        "content": "The promotion rules are as follows:\n- A student must have a minimum of 16 earned credits by the end of Semester II to be promoted to Semester III or IV.\n- A student must have a minimum of 60 earned credits, including at least 36 credits from the first two semesters, by the end of Semester IV to be promoted to Semester V or VI.\n- A student must have a minimum of 108 earned credits, including at least 80 credits from the first four semesters, by the end of Semester VI to be promoted to Semester VII or VIII.\n- If a student is not promoted more than three times, their admission will be cancelled and their name will be removed from the rolls.\n- A student whose name is removed can appeal to the Vice-Chancellor, and if allowed, the total duration of the program can be extended by a maximum of two semesters (beyond 14 semesters)."
      }
    ],
    "lastAccessed": 1775048059506
  },
